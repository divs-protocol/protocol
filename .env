# Public configuration, tracked on purpose.
#
# NEXT_PUBLIC_ values are compiled into the browser bundle, so anyone who opens
# the site can read them. Keeping this one here means a fresh clone, a preview
# deployment and production all connect wallets without per-environment setup.
#
# It is not a secret, but it is a quota: the project's monthly active users are
# billed against it. Abuse is prevented by Allowed Domains in the Reown
# dashboard, not by hiding this value.
#
# Anything that IS secret belongs in .env.local, which stays ignored.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=3582d51bb0cbc7ebd35c7d75a2899ec4
